<Page x:Class="Biblans_Tråkia_Surtant.StartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Biblans_Tråkia_Surtant"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="StartPage">

    <Grid Background="White">
        <StackPanel Margin="10">
            <TextBlock Text="BETA: Media from database" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
            <Button x:Name="Btn_Refresh" Content="Refresh" Width="100" Click="Btn_Refresh_Click" Margin="0,0,0,10"/>
            <DataGrid x:Name="MediaGrid" AutoGenerateColumns="True" IsReadOnly="True" Height="300"/>
        </StackPanel>
    </Grid>
</Page>
