<Page x:Class="Biblans_Tråkia_Surtant.Historik"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Lånehistorik">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Min lånehistorik" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="Uppdatera" Click="Btn_Refresh_Click" Padding="12,6"/>
                <Button Content="Till katalogen" Click="Btn_Back_Click" Padding="12,6" Margin="8,0,0,0"/>
            </StackPanel>
        </DockPanel>

        <DataGrid x:Name="HistoryGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Typ" Binding="{Binding MediaType}" Width="*"/>
                <DataGridTextColumn Header="Titel" Binding="{Binding Title}" Width="2*"/>
                <DataGridTextColumn Header="Författare/skapare" Binding="{Binding Authors}" Width="2*"/>
                <DataGridTextColumn Header="Lånad" Binding="{Binding BorrowedDate, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="*"/>
                <DataGridTextColumn Header="Förfallodatum" Binding="{Binding DueDate, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="*"/>
                <DataGridTextColumn Header="Återlämnad" Binding="{Binding ReturnedDate, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="*"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
                <DataGridTextColumn Header="Avgift" Binding="{Binding InvoiceAmount}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="Txt_Status" Grid.Row="2" Margin="0,8,0,0"/>
    </Grid>
</Page>
