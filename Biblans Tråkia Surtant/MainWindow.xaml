<Window x:Class="Biblans_Tråkia_Surtant.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bibliotekssystem" Height="450" Width="800">
    <Grid>
        <!-- 1. The Frame that loads either AdminPage or StartPage -->
        <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden"/>

        <!-- 2. The Login Panel (Visible on startup, hidden after login) -->
        <StackPanel x:Name="LoginPanel" Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Inloggning" FontSize="20" FontWeight="Bold" Margin="0,0,0,15" HorizontalAlignment="Center"/>

            <TextBox x:Name="Login_Email_TextBox" Width="220" Margin="5"/>
            <PasswordBox x:Name="Login_Password_Box" Width="220" Margin="5"/>
            <Button x:Name="Btn_Connection" Content="Logga in" Click="Btn_Connection_Click" Width="220" Margin="10"/>
        </StackPanel>
    </Grid>
</Window>