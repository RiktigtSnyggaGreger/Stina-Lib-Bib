<Window x:Class="Biblans_Tråkia_Surtant.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bibliotekssystem" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top bar med knappar för Inloggning/Utloggning -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8" ZIndex="10">
            <Button x:Name="Btn_OpenLogin" Content="Logga in" Click="Btn_OpenLogin_Click" Padding="12,6" Margin="0,0,8,0"/>
            <Button x:Name="Btn_Logout" Content="Logga ut" Click="Btn_Logout_Click" Padding="12,6" Visibility="Collapsed"/>
        </StackPanel>

        <!-- The Frame that loads StartPage directly -->
        <Frame x:Name="MainFrame" Grid.Row="1" NavigationUIVisibility="Hidden"/>

        <!-- The Login Panel (Dold som standard, visas när man klickar på Logga in) -->
        <Grid x:Name="LoginPanel" Grid.RowSpan="2" Background="#80000000" Visibility="Collapsed" ZIndex="20">
            <Border Background="White" CornerRadius="10" Padding="20" Width="300" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Inloggning" FontSize="20" FontWeight="Bold" Margin="0,0,0,15" HorizontalAlignment="Center"/>
                    <TextBlock Text="E-post:" Margin="0,0,0,3"/>
                    <TextBox x:Name="Login_Email_TextBox" Width="260" Margin="0,0,0,10" Padding="4"/>

                    <TextBlock Text="Lösenord:" Margin="0,0,0,3"/>
                    <PasswordBox x:Name="Login_Password_Box" Width="260" Margin="0,0,0,15" Padding="4"/>
                    <Button x:Name="Btn_Connection" Content="Logga in" Click="Btn_Connection_Click" Width="260" Padding="6" Background="#4CAF50" Foreground="White" FontWeight="Bold"/>
                    <Button Content="Avbryt" Click="Btn_CloseLogin_Click" Width="260" Margin="0,8,0,0" Padding="6"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>