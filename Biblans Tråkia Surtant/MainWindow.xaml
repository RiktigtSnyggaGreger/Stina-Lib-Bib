<Window x:Class="Biblans_Tråkia_Surtant.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Biblans_Tråkia_Surtant"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">

                <Button Content="Check connection" 
                Click="Btn_Connection_Click" 
                Padding="8" FontSize="14" FontWeight="Bold" Margin="0,5,0,5"/>
                <ListBox x:Name="Connection_Box" Height="120" FontSize="13" Margin="0,0,0,15"/>

                <TextBox x:Name="Login_Email_TextBox" Width="200" Margin="5"/>
                <PasswordBox x:Name="Login_Password_Box" Width="200" Margin="5"/>
                <Button x:Name="Btn_Connection" Content="Connect &amp; Login" Click="Btn_Connection_Click"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
