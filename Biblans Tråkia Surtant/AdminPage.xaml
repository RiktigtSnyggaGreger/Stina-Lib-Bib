<Page x:Class="Biblans_Tråkia_Surtant.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="AdminPage" Height="450" Width="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Frame x:Name="AdminFrame" NavigationUIVisibility="Hidden"/>

        <TextBlock Grid.Row="0" Text="Användarhantering (Admin)" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

        <!-- DataGrid to show users -->
        <DataGrid Grid.Row="1" x:Name="Admin_Show_Users" AutoGenerateColumns="True" IsReadOnly="True"/>
        <StackPanel x:Name="CreateUserPanel" Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Create User" FontSize="20" FontWeight="Bold" Margin="0,0,0,15" HorizontalAlignment="Center"/>


            <TextBox x:Name="Create_User_Name" Text="Name" Width="220" Margin="5"/>
            <TextBox x:Name="Create_User_Lastname" Text="Lastname" Width="220" Margin="5"/>
            <CheckBox x:Name="Create_User_IsAdmin" Content="Is Admin?" Width="220" Margin="5"/>
            <TextBox x:Name="Create_User_Email" Text="Email" Width="220" Margin="5"/>
            <PasswordBox x:Name="Create_User_Password" Width="220" Margin="5" ToolTip="Ange ett säkert lösenord"/>
            <Button x:Name="Btn_Create_User" Content="Create user" Click="Btn_Create_User_Click" Width="220" Margin="10"/>
        </StackPanel>
    </Grid>
</Page>