<Page x:Class="Biblans_Tråkia_Surtant.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="AdminPage">

    <Grid Margin="20">
        <!-- Define 3 equal columns -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- Define rows -->
        <Grid.RowDefinitions>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <!-- Hidden navigation frame -->
        <Frame x:Name="AdminFrame" NavigationUIVisibility="Hidden"/>

        <!-- LEFT COLUMN (Column 0): Active & Invoiced Loans (Spans 2 rows) -->
        <ScrollViewer Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="10">
            <!-- SINGLE StackPanel containing both tables -->
            <StackPanel HorizontalAlignment="Stretch">

                <!-- Active Loans Section -->
                <TextBlock Text="Active Loans" FontSize="20" FontWeight="Bold" Margin="0,0,0,10" HorizontalAlignment="Center"/>

                <DataGrid x:Name="ActiveLoansGrid" 
                          AutoGenerateColumns="False" 
                          IsReadOnly="True" 
                          GridLinesVisibility="Horizontal" 
                          SelectionChanged="ActiveLoansGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="User" Binding="{Binding FullName}" Width="*"/>
                        <DataGridTextColumn Header="Media" Binding="{Binding MediaTitle}" Width="*"/>
                        <DataGridTextColumn Header="Due Date" Binding="{Binding DueDate, StringFormat=yyyy-MM-dd}" Width="Auto"/>

                        <DataGridTemplateColumn Header="Remove" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Return" 
                                            Click="Btn_Admin_Deloan_Click" 
                                            Padding="5,2" 
                                            Margin="0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Invoiced Loans Section wrapped in a GroupBox -->
                <GroupBox Header="Fakturerade / Förfallna Lån" Margin="0,20,0,0">
                    <DataGrid x:Name="InvoicedLoansGrid" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Lån ID" Binding="{Binding Loan_ID}" />
                            <DataGridTextColumn Header="Exemplar ID" Binding="{Binding Copy_ID}" />
                            <DataGridTextColumn Header="Låntagare" Binding="{Binding FullName}" />
                            <DataGridTextColumn Header="Titel" Binding="{Binding MediaTitle}" />
                            <DataGridTextColumn Header="Förfallodatum" Binding="{Binding DueDate, StringFormat=yyyy-MM-dd}" />
                            <!-- Invoice Amount Column -->
                            <DataGridTextColumn Header="Fakturabelopp" Binding="{Binding InvoiceAmount, StringFormat='{}{0} kr'}" />

                            <!-- Paid / Return Button Column -->
                            <DataGridTemplateColumn Header="Åtgärd">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Betald &amp; Återlämnad" 
                                                Click="Btn_Paid_And_Return_Click" 
                                                Padding="5,2" 
                                                Background="#4CAF50" 
                                                Foreground="White" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <!-- MIDDLE COLUMN (Column 1): Create User & User Management -->
        <ScrollViewer Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="10">
            <StackPanel x:Name="CreateUserPanel" HorizontalAlignment="Center" VerticalAlignment="Top">

                <TextBlock Text="Create User" FontSize="20" FontWeight="Bold" Margin="0,0,0,10" HorizontalAlignment="Center"/>

                <StackPanel Margin="5" Orientation="Horizontal">
                    <TextBlock Text="Name:" Width="70" VerticalAlignment="Center"/>
                    <TextBox x:Name="Create_User_Name" Width="180" Margin="3"/>
                </StackPanel>

                <StackPanel Margin="5" Orientation="Horizontal">
                    <TextBlock Text="Last name:" Width="70" VerticalAlignment="Center"/>
                    <TextBox x:Name="Create_User_Lastname" Width="180" Margin="3"/>
                </StackPanel>

                <StackPanel Margin="5" Orientation="Horizontal">
                    <TextBlock Text="Admin?:" Width="70" VerticalAlignment="Center"/>
                    <CheckBox x:Name="Create_User_IsAdmin" Margin="3" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Margin="5" Orientation="Horizontal">
                    <TextBlock Text="Email:" Width="70" VerticalAlignment="Center"/>
                    <TextBox x:Name="Create_User_Email" Width="180" Margin="3"/>
                </StackPanel>

                <StackPanel Margin="5" Orientation="Horizontal">
                    <TextBlock Text="Password:" Width="70" VerticalAlignment="Center"/>
                    <PasswordBox x:Name="Create_User_Password" Width="180" Margin="3" ToolTip="Ange ett säkert lösenord"/>
                </StackPanel>

                <Button x:Name="Btn_Create_User" Content="Create user" Click="Btn_Create_User_Click" Width="180" Margin="8"/>

                <TextBlock Text="Användare &amp; Hantering" FontSize="18" FontWeight="Bold" Margin="0,15,0,5" HorizontalAlignment="Center"/>

                <StackPanel Margin="0,5,0,0" Orientation="Vertical" HorizontalAlignment="Center">
                    <DataGrid x:Name="Admin_Show_Users" 
                              AutoGenerateColumns="False" 
                              IsReadOnly="True" 
                              MaxHeight="180">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding User_ID}" Width="40"/>
                            <DataGridTextColumn Header="Namn" Binding="{Binding Name}" Width="80"/>
                            <DataGridTextColumn Header="Efternamn" Binding="{Binding Lastname}" Width="90"/>
                            <DataGridTextColumn Header="E-post" Binding="{Binding Email}" Width="120"/>
                            <DataGridTextColumn Header="Admin" Binding="{Binding IsAdmin}" Width="50"/>

                            <DataGridTemplateColumn Header="Åtgärd" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Redigera" 
                                                Click="Btn_Open_Edit_Modal_Click" 
                                                Padding="5,2"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button x:Name="Btn_Delete_Selected" 
                            Content="Ta bort markerad användare" 
                            Click="Btn_Delete_Selected_Click" 
                            Padding="8,4" 
                            Margin="0,8,0,0"
                            HorizontalAlignment="Center"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <!-- RIGHT COLUMN (Column 2): Third section -->
        <ScrollViewer Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" VerticalScrollBarVisibility="Auto" Margin="10">
            <StackPanel x:Name="MediaManagementPanel" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                <Button x:Name="Btn_Admin_Media_Page" 
                        Content="Media sida" 
                        Click="Btn_Goto_Media_Click" 
                        Padding="8,4" 
                        Margin="0,8,0,0"
                        HorizontalAlignment="Center"/>
            </StackPanel>
        </ScrollViewer>

        <!-- MODAL POPUP FÖR REDIGERING (Ligger sist i huvud-Griden) -->
        <Grid x:Name="EditUserModal" 
              Background="#80000000" 
              Visibility="Collapsed" 
              Grid.ColumnSpan="3"
              Grid.RowSpan="2">

            <Border Background="White" 
                    CornerRadius="10" 
                    Padding="20" 
                    Width="350" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center">
                <StackPanel>
                    <!-- Stängknapp -->
                    <Button Content="✕" 
                            Click="Btn_Close_Edit_Modal_Click" 
                            HorizontalAlignment="Right" 
                            Background="Transparent" 
                            BorderThickness="0" 
                            FontSize="16" 
                            FontWeight="Bold" 
                            Cursor="Hand"/>

                    <TextBlock Text="Redigera användare" FontSize="18" FontWeight="Bold" Margin="0,0,0,15" HorizontalAlignment="Center"/>

                    <StackPanel Margin="5" Orientation="Horizontal">
                        <TextBlock Text="Namn:" Width="80" VerticalAlignment="Center"/>
                        <TextBox x:Name="Edit_User_Name" Width="180" Margin="3"/>
                    </StackPanel>

                    <StackPanel Margin="5" Orientation="Horizontal">
                        <TextBlock Text="Efternamn:" Width="80" VerticalAlignment="Center"/>
                        <TextBox x:Name="Edit_User_Lastname" Width="180" Margin="3"/>
                    </StackPanel>

                    <StackPanel Margin="5" Orientation="Horizontal">
                        <TextBlock Text="E-post:" Width="80" VerticalAlignment="Center"/>
                        <TextBox x:Name="Edit_User_Email" Width="180" Margin="3"/>
                    </StackPanel>

                    <StackPanel Margin="5" Orientation="Horizontal">
                        <TextBlock Text="Admin?:" Width="80" VerticalAlignment="Center"/>
                        <CheckBox x:Name="Edit_User_IsAdmin" Margin="3" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Margin="5" Orientation="Horizontal">
                        <TextBlock Text="Nytt lösen:" Width="80" VerticalAlignment="Center"/>
                        <PasswordBox x:Name="Edit_User_Password" Width="180" Margin="3" ToolTip="Lämna tomt om du inte vill ändra lösenord"/>
                    </StackPanel>

                    <!-- Spara-knapp -->
                    <Button Content="Spara ändringar" 
                            Click="Btn_Save_Edit_User_Click" 
                            Background="#4CAF50" 
                            Foreground="White" 
                            FontSize="14" 
                            FontWeight="Bold" 
                            Padding="10,8" 
                            Margin="0,15,0,0"
                            Cursor="Hand"/>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Page>