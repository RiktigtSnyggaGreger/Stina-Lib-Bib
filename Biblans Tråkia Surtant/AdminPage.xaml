<Page x:Class="Biblans_Tråkia_Surtant.AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="AdminPage" Height="450" Width="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Frame x:Name="AdminFrame" NavigationUIVisibility="Hidden"/>

        <TextBlock Grid.Row="0" Text="Användarhantering (Admin)" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>

        <!-- DataGrid to show users -->
        <DataGrid Grid.Row="1" x:Name="Admin_Show_Users" AutoGenerateColumns="True" IsReadOnly="True"/>
    </Grid>
</Page>